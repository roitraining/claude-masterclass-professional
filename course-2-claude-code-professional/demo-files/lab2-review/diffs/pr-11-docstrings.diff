 from lending.config import FINE_CAP_CENTS, FINE_CENTS_PER_DAY
 
 
 def days_late(due, returned):
+    """Whole days between the due date and the return date, never negative."""
     return max(0, (returned - due).days)
 
 
 def fine_cents(due, returned):
+    """Fine in cents for a loan, capped at FINE_CAP_CENTS."""
     return min(FINE_CAP_CENTS, days_late(due, returned) * FINE_CENTS_PER_DAY)
